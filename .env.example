# ==============================================================================
# RESQ.AI · BhuRaksha — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   cp .env.example .env
#
# NOTE: Never commit your actual '.env' file containing real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Storage Configuration
# ------------------------------------------------------------------------------
APP_NAME="RESQ.AI × BhuRaksha"
API_V1_PREFIX="/api/v1"
DEBUG=true

# SQLite Database and directory paths (defaults resolve relative to project root)
DATABASE_PATH="./bhuraksha.db"
DATAPACK_DIR="./data/datapacks"
SIM_RUN_DIR="./data/simulation_runs"
SIM_MAX_RUNS=40

# Allowed CORS origins (comma-separated list, or '*' for development)
CORS_ORIGINS="*"

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens.
# Generate a strong 256-bit key using: openssl rand -hex 32
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# 3. Default RBAC Seed Accounts (used when running 'make seed')
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@bhuraksha.demo
ADMIN_PASSWORD=Admin@RESQ26

APPROVER_EMAIL=collector@bhuraksha.demo
APPROVER_PASSWORD=Approve@RESQ26

OPERATOR_EMAIL=operator@bhuraksha.demo
OPERATOR_PASSWORD=Operate@RESQ26

FIELD_EMAIL=field@bhuraksha.demo
FIELD_PASSWORD=Field@RESQ26

# ------------------------------------------------------------------------------
# 4. Local Qwen3-4B LLM & QLoRA Fine-Tuning
# ------------------------------------------------------------------------------
# Hugging Face cache directory
HF_HOME="./.cache/huggingface"

# Base foundation model repository on Hugging Face
QWEN_MODEL_ID=Qwen/Qwen3-4B

# Directory containing the fine-tuned QLoRA LoRA adapter
QWEN_ADAPTER_DIR="./data/models/qwen3_4b_qlora_adapter"

# Enable/disable local neural model (if false or GPU unavailable, falls back to deterministic rules)
QWEN_ENABLED=true

# Load in 4-bit NF4 quantization using bitsandbytes (requires CUDA GPU, uses ~3.5GB VRAM)
# Set to false for full 16-bit float / CPU execution
QWEN_LOAD_IN_4BIT=true

# Generation inference hyperparameters
QWEN_MAX_NEW_TOKENS=384
QWEN_TEMPERATURE=0.2
QWEN_TOP_P=0.9
QWEN_TIMEOUT_SECONDS=45.0
QWEN_ENABLE_THINKING=false

# Offline mode: when true, skips external Hugging Face hub checks
FORCED_OFFLINE=false

# Optional external LLM fallback key (optional)
EMERGENT_LLM_KEY=
LLM_MODEL=Qwen/Qwen3-4B

# ------------------------------------------------------------------------------
# 5. TextBee.dev SMS Gateway (Emergency Officer Dispatch)
# ------------------------------------------------------------------------------
# TextBee Android SMS Gateway integration (https://textbee.dev / https://github.com/textbee/textbee)
# Provides autonomous cellular SMS dispatch directly via an Android smartphone relay.
TEXTBEE_API_KEY=txb_your_textbee_api_key_here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1/gateway
TEXTBEE_DEVICE_ID=your_device_id_here
TEXTBEE_PHONE_NAME="motorola moto g34 5G"
TEXTBEE_DEFAULT_PHONE=+919876543210

# ------------------------------------------------------------------------------
# 6. Secondary / Legacy Alert Providers (Optional)
# ------------------------------------------------------------------------------
SMS_PROVIDER=textbee
SMSHORIZON_API_KEY=
SMSHORIZON_SENDER_ID=
SMSHORIZON_DLT_ENTITY_ID=
SMSHORIZON_TEMPLATE_ID=
SMSHORIZON_API_URL=https://smshorizon.in/api/sendsms.php
SMS_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 7. Frontend Web Application (apps/web)
# ------------------------------------------------------------------------------
# Base API URL for frontend (leave blank if running behind Vite dev proxy on same host)
VITE_API_BASE_URL=
# Enable quick-login buttons on the login screen for rapid demo evaluation
VITE_DEMO_MODE=true
