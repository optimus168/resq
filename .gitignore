# ------------------------------------------------------------------------------
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.h5
*.tflite
*.ckpt
data/models/**/*.safetensors
data/models/**/*.bin
data/models/qwen3_4b_qlora_adapter/*.safetensors

# ------------------------------------------------------------------------------
# 6. Simulation Outputs & Uploaded Media
# ------------------------------------------------------------------------------
data/simulation_runs/*
!data/simulation_runs/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
!data/uploads/reports/
data/uploads/reports/*
!data/uploads/reports/.gitkeep
*.npz
*.npz.tmp*

